# Copy to .env for local development, the probe, and smoke tests. Never commit .env.
# One bearer JWT per tenant, from Netic onboarding. The same token can submit web
# leads, so never paste it anywhere but this file.
NETIC_TENANTS=stl,nash,blue,ferg
NETIC_TENANT_STL_TOKEN=
NETIC_TENANT_NASH_TOKEN=
NETIC_TENANT_BLUE_TOKEN=
NETIC_TENANT_FERG_TOKEN=

# Optional. Where exports are written. Defaults to Documents/Netic Reports.
# NETIC_OUTPUT_DIR=./smoke-output

# Optional tuning.
# NETIC_BASE_URL=https://app.netic.ai
# NETIC_TIMEOUT_MS=120000
